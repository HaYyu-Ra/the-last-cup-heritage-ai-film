{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "title":"Heritage Short storyboard contract",
 "type":"object",
 "required":["project","music","shots"],
 "properties":{
  "project":{"type":"object","required":["title","language","total_duration_seconds","fps","style"],"properties":{"title":{"type":"string"},"language":{"type":"string"},"subtitle_language":{"type":"string"},"total_duration_seconds":{"type":"integer","minimum":60,"maximum":90},"fps":{"type":"integer","enum":[24,25,30]},"style":{"type":"string"}},"additionalProperties":true},
  "music":{"type":"object","required":["prompt","volume"],"properties":{"prompt":{"type":"string"},"volume":{"type":"number","minimum":0,"maximum":1},"ducking":{"type":"boolean"}},"additionalProperties":true},
  "shots":{"type":"array","minItems":8,"maxItems":12,"items":{"type":"object","required":["id","duration","reason","image_prompt","motion_prompt","narration_am","subtitle_en"],"properties":{"id":{"type":"string","pattern":"^shot_[0-9]{2}$"},"duration":{"type":"integer","minimum":3,"maximum":15},"reason":{"type":"string","minLength":5},"image_prompt":{"type":"string","minLength":10},"motion_prompt":{"type":"string"},"narration_am":{"type":"string"},"subtitle_en":{"type":"string"}},"additionalProperties":true}}
 },
 "additionalProperties":true
}